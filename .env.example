# Server-only. Copy to .env.local; do not commit real values.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Portfolio <hello@your-domain>
CONTACT_FROM_EMAIL=
# Set to your verified receiving email; deliberately no inferred default.
CONTACT_TO_EMAIL=
# Exact public origin, no trailing slash. Use http://localhost:3000 for local setup.
CONTACT_ORIGIN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret at least 32 characters. Used to hash client IPs and idempotency keys.
CONTACT_RATE_LIMIT_SECRET=
# On Vercel, VERCEL=1 selects its overwritten x-vercel-forwarded-for header.
# Else set ONLY to a header your trusted reverse proxy overwrites with ONE client IP.
# Do not expose the app directly with an attacker-controlled forwarded-IP header.
CONTACT_TRUSTED_IP_HEADER=
